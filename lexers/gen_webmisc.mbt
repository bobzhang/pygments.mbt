///|
/// Creates a `XQueryLexer` (XQuery).
pub fn x_query_lexer(options? : @lexer.Options = Map([])) -> @lexer.Lexer raise {
  @lexer.Lexer::new(
    x_query_lexer_info,
    options,
    opts => x_query_lexer(options=opts),
    (lx, text, stack) => {
      @lexer.run_regex(
        lx,
        x_query_lexer_def.force(),
        text,
        stack,
        callbacks=x_query_lexer_callbacks(lx),
      )
    },
  )
}
