///|
/// Creates a `ArduinoLexer` (Arduino).
pub fn arduino_lexer(options? : @lexer.Options = Map([])) -> @lexer.Lexer raise {
  @lexer.Lexer::new(
    arduino_lexer_info,
    options,
    opts => arduino_lexer(options=opts),
    (lx, text, stack) => {
      @lexer.run_regex(lx, arduino_lexer_def.force(), text, stack)
    },
  )
}

