///|
/// Creates a `ECLexer` (eC).
pub fn ec_lexer(options? : @lexer.Options = Map([])) -> @lexer.Lexer raise {
  @lexer.Lexer::new(ec_lexer_info, options, opts => ec_lexer(options=opts), (
    lx,
    text,
    stack,
  ) => @lexer.run_regex(lx, ec_lexer_def.force(), text, stack))
}

