pub fn pike_lexer(options? : @lexer.Options = Map([])) -> @lexer.Lexer raise {
  @lexer.Lexer::new(
    pike_lexer_info,
    options,
    opts => pike_lexer(options=opts),
    (lx, text, stack) => {
      @lexer.run_regex(lx, pike_lexer_def.force(), text, stack)
    },
  )
}

