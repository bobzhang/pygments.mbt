pub fn nes_c_lexer(options? : @lexer.Options = Map([])) -> @lexer.Lexer raise {
  @lexer.Lexer::new(
    nes_c_lexer_info,
    options,
    opts => nes_c_lexer(options=opts),
    (lx, text, stack) => {
      @lexer.run_regex(lx, nes_c_lexer_def.force(), text, stack)
    },
  )
}

