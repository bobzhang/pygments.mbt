///|
/// Creates a `SwigLexer` (SWIG).
pub fn swig_lexer(options? : @lexer.Options = Map([])) -> @lexer.Lexer raise {
  @lexer.Lexer::new(
    swig_lexer_info,
    options,
    opts => swig_lexer(options=opts),
    (lx, text, stack) => {
      @lexer.run_regex(lx, swig_lexer_def.force(), text, stack)
    },
  )
}

///|
