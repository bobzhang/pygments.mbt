  aliases: ["vala", "vapi"],
  filenames: ["*.vala", "*.vapi"],
  alias_filenames: [],
  mimetypes: ["text/x-vala"],
  priority: 0.0,
  url: "https://vala.dev",
  version_added: "1.1",
  analyse_text: @lexer.no_analyse,
}

