    r(21, 8, Emit(tk_literal_number), None),
    r(7415, 8, Emit(tk_text), None),
    r(7416, 8, Emit(tk_literal_string), None),
  ]
  @lexer.RegexDef::new(
    "UnixConfigLexer",
    ["root"],
    rules,
    [[0, 1, 2, 3, 4, 5]],
    extended=false,
  )
})

///|
/// Creates a `UnixConfigLexer` (Unix/Linux config files).
pub fn unix_config_lexer(
  options? : @lexer.Options = Map([]),
) -> @lexer.Lexer raise {
  @lexer.Lexer::new(
    unix_config_lexer_info,
    options,
    opts => unix_config_lexer(options=opts),
    (lx, text, stack) => {
      @lexer.run_regex(lx, unix_config_lexer_def.force(), text, stack)
    },
  )
}
