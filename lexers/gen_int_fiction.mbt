///|
/// Creates a `Inform6Lexer` (Inform 6).
pub fn inform6_lexer(options? : @lexer.Options = Map([])) -> @lexer.Lexer raise {
  @lexer.Lexer::new(
    inform6_lexer_info,
    options,
    opts => inform6_lexer(options=opts),
    inform6_lexer_tokenizer,
  )
}

