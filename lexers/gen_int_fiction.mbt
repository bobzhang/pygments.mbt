///|
/// Creates a `Inform7Lexer` (Inform 7).
pub fn inform7_lexer(options? : @lexer.Options = Map([])) -> @lexer.Lexer raise {
  @lexer.Lexer::new(
    inform7_lexer_info,
    options,
    opts => inform7_lexer(options=opts),
    inform7_lexer_tokenizer,
  )
}

