  alias_filenames: [],
  mimetypes: ["text/x-scss"],
  priority: 0.0,
  url: "https://sass-lang.com/",
  version_added: "",
  analyse_text: @lexer.no_analyse,
}

///|
let scss_lexer_def : @lazy.Lazy[@lexer.RegexDef] = @lazy.Lazy(() => {
  let rules = [
    r(0, 18, Emit(tk_text_whitespace), None),
    r(81, 18, Emit(tk_comment_single), None),
    r(82, 18, Emit(tk_comment_multiline), None),
    r(6399, 18, Emit(tk_keyword), Some([Push("value")])),
    r(6400, 18, Emit(tk_keyword), Some([Push("for")])),
    r(6401, 18, Emit(tk_keyword), Some([Push("value")])),
    r(6526, 18, ByGroups([Emit(tk_keyword), Emit(tk_name_function)]), Some([Push("value")])),
