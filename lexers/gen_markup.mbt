///|
/// Creates a `WikitextLexer` (Wikitext).
pub fn wikitext_lexer(
  options? : @lexer.Options = Map([]),
) -> @lexer.Lexer raise {
  @lexer.Lexer::new(
    wikitext_lexer_info,
    options,
    opts => wikitext_lexer(options=opts),
    (lx, text, stack) => {
      @lexer.run_regex(lx, wikitext_lexer_def.force(), text, stack)
    },
  )
}
