///|
/// Creates a `ObjectiveCppLexer` (Objective-C++).
pub fn objective_cpp_lexer(
  options? : @lexer.Options = Map([]),
) -> @lexer.Lexer raise {
  @lexer.Lexer::new(
    objective_cpp_lexer_info,
    options,
    opts => objective_cpp_lexer(options=opts),
    (lx, text, stack) => {
      @lexer.run_regex(lx, objective_cpp_lexer_def.force(), text, stack)
    },
  )
}

