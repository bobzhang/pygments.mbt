///|
/// Creates a `LogosLexer` (Logos).
pub fn logos_lexer(options? : @lexer.Options = Map([])) -> @lexer.Lexer raise {
  @lexer.Lexer::new(
    logos_lexer_info,
    options,
    opts => logos_lexer(options=opts),
    (lx, text, stack) => {
      @lexer.run_regex(lx, logos_lexer_def.force(), text, stack)
    },
  )
}

