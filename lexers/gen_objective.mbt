///|
/// Creates a `ObjectiveCLexer` (Objective-C).
pub fn objective_c_lexer(
  options? : @lexer.Options = Map([]),
) -> @lexer.Lexer raise {
  @lexer.Lexer::new(
    objective_c_lexer_info,
    options,
    opts => objective_c_lexer(options=opts),
    (lx, text, stack) => {
      @lexer.run_regex(lx, objective_c_lexer_def.force(), text, stack)
    },
  )
}

