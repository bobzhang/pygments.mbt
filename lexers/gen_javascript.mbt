    r(4572, 26, Emit(tk_literal_string_interpol), Some([Push("interpolation")])),
    r(98, 0, Nop, Some([Pop])),
    r(1717, 26, Emit(tk_name_function), None),
    r(4572, 26, Emit(tk_literal_string_interpol), Some([Push("interpolation")])),
    r(98, 0, Nop, Some([Pop])),
    r(0, 26, Emit(tk_text_whitespace), None),
    r(152, 26, Emit(tk_name_variable), Some([Pop])),
    r(224, 26, Emit(tk_literal_string), Some([Push("string-single-pop2")])),
