///|
/// Creates a `HaxeLexer` (Haxe).
pub fn haxe_lexer(options? : @lexer.Options = Map([])) -> @lexer.Lexer raise {
  @lexer.Lexer::new(haxe_lexer_info, options, opts => haxe_lexer(options=opts), (lx, text, stack) => @lexer.run_regex(lx, haxe_lexer_def.force(), text, stack, callbacks=haxe_lexer_callbacks(lx)))
}

///|
pub let hxml_lexer_info : @lexer.LexerInfo = {
  class_name: "HxmlLexer",
  name: "Hxml",
  aliases: ["haxeml", "hxml"],
  filenames: ["*.hxml"],
  alias_filenames: [],
  mimetypes: [],
  priority: 0.0,
  url: "https://haxe.org/manual/compiler-usage-hxml.html",
  version_added: "1.6",
  analyse_text: @lexer.no_analyse,
}

///|
let hxml_lexer_def : @lazy.Lazy[@lexer.RegexDef] = @lazy.Lazy(() => {
  let rules = [
    r(3203, 8, ByGroups([Emit(tk_punctuation), Emit(tk_generic_heading)]), None),
    r(3204, 8, ByGroups([Emit(tk_punctuation), Emit(tk_keyword_keyword)]), None),
    r(3205, 8, ByGroups([Emit(tk_punctuation), Emit(tk_keyword)]), None),
    r(3206, 8, ByGroups([Emit(tk_punctuation), Emit(tk_keyword), Emit(tk_text_whitespace), Emit(tk_literal_string)]), None),
    r(3207, 8, ByGroups([Emit(tk_punctuation), Emit(tk_keyword), Emit(tk_text_whitespace), Emit(tk_literal_number_integer)]), None),
    r(3208, 8, ByGroups([Emit(tk_punctuation), Emit(tk_keyword), Emit(tk_text_whitespace), Emit(tk_literal_number_integer), Emit(tk_punctuation), Emit(tk_literal_number_integer), Emit(tk_punctuation), Emit(tk_literal_number_integer), Emit(tk_punctuation), Emit(tk_literal_number_hex)]), None),
    r(3209, 8, ByGroups([Emit(tk_punctuation), Emit(tk_keyword), Emit(tk_text_whitespace), Emit(tk_literal_string)]), None),
    r(1103, 8, Emit(tk_comment_single), None),
  ]
  @lexer.RegexDef::new(
    "HxmlLexer",
    ["root"],
    rules,
    [[0, 1, 2, 3, 4, 5, 6, 7]],
    extended=false,
  )
})

///|
/// Creates a `HxmlLexer` (Hxml).
pub fn hxml_lexer(options? : @lexer.Options = Map([])) -> @lexer.Lexer raise {
  @lexer.Lexer::new(hxml_lexer_info, options, opts => hxml_lexer(options=opts), (lx, text, stack) => @lexer.run_regex(lx, hxml_lexer_def.force(), text, stack))
}
