// Ports of tests/test_html_formatter.py (tests that need files, external
// validators or the `ctags` module are covered differently or skipped).

///|
let html_test_source : String =
  #|import os
  #|from os import path
  #|
  #|TESTDIR = path.dirname(path.abspath(__file__))
  #|
  #|def test_correct_output():
  #|    s = "a \"b\" 'c' & <d>"
  #|    return [x ** 2 for x in range(10)]  # comment
  #|

///|
fn html_test_tokens() -> Array[(@token.TokenType, String)] raise {
  @lexers.get_lexer_by_name("python").get_tokens(html_test_source)
}

///|
fn html_format(options : Map[String, String]) -> String raise {
  @formatters.HtmlFormatter::new(options~).format(html_test_tokens())
}

///|
/// `re.sub('<.*?>', '', s)`.
fn strip_tags(s : String) -> String {
  let buf = StringBuilder()
  let mut in_tag = false
  for c in s {
    if in_tag {
      if c == '>' {
        in_tag = false
      }
    } else if c == '<' {
      in_tag = true
    } else {
      buf.write_char(c)
    }
  }
  buf.to_string()
}

///|
test "correct output" {
  let tokens = html_test_tokens()
  let html = @formatters.HtmlFormatter::new(options={ "nowrap": "True" }).format(
    tokens,
  )
  let text = @formatters.null_formatter().format(tokens)
  assert_eq(strip_tags(html), @pystr.html_escape(text, quote=false))
}

///|
test "quotes in token text are not escaped" {
  let out = @formatters.HtmlFormatter::new(options={ "nowrap": "True" }).format([
      (@token.text, "a \"b\" 'c' & <d>\n"),
    ],
  )
  assert_true(out.contains("\"b\""))
  assert_true(out.contains("'c'"))
  assert_true(!out.contains("&quot;"))
  assert_true(!out.contains("&#x27;"))
  assert_true(out.contains("&amp;"))
  assert_true(out.contains("&lt;d&gt;"))
}

///|
test "external css" {
  let f = @formatters.HtmlFormatter::new(options={
    "full": "True",
    "cssfile": "fmt1.css",
    "outencoding": "utf-8",
  })
  let out = f.format(html_test_tokens())
  assert_true(
    out.contains(
      "<link rel=\"stylesheet\" href=\"fmt1.css\" type=\"text/css\">",
    ),
  )
  assert_true(f.cssfile_contents().has_prefix("/*\ngenerated by Pygments"))
  assert_true(f.cssfile_contents().contains("body .k { "))
  let aux = f.to_formatter().aux_files()
  assert_eq(aux.length(), 1)
  assert_eq(aux[0].path, "fmt1.css")
  assert_eq(aux[0].contents, f.cssfile_contents())
  assert_eq(
    @formatters.HtmlFormatter::new().to_formatter().aux_files().length(),
    0,
  )
}

///|
test "all options" {
  let tokens = html_test_tokens()
  for
    options in [
      { "nowrap": "True" },
      { "linenos": "True", "full": "True" },
      { "linenos": "True", "linespans": "L" },
      { "hl_lines": "1 5 10 xxx" },
      { "hl_lines": "1 5 10", "noclasses": "True" },
    ] {
    ignore(@formatters.HtmlFormatter::new(options~).format(tokens))
  }
  for linenos in ["", "table", "inline"] {
    for noclasses in ["False", "True"] {
      for linenospecial in ["0", "5"] {
        for anchorlinenos in ["False", "True"] {
          let options = {
            "noclasses": noclasses,
            "linenospecial": linenospecial,
            "anchorlinenos": anchorlinenos,
          }
          if linenos != "" {
            options["linenos"] = linenos
          }
          ignore(@formatters.HtmlFormatter::new(options~).format(tokens))
        }
      }
    }
  }
}

///|
test "linespans" {
  let html = html_format({
    "linespans": "L",
    "anchorlinenos": "True",
    "linenos": "inline",
  })
  assert_true(
    html.contains(
      "<span id=\"L-1\"><a href=\"#L-1\"><span class=\"linenos\">1</span></a>",
    ),
  )
}

///|
test "lineanchors" {
  let html = html_format({ "lineanchors": "foo" })
  assert_true(
    html.contains(
      "<pre><span></span><a id=\"foo-1\" name=\"foo-1\" href=\"#foo-1\">",
    ),
  )
}

///|
test "lineanchors with startnum" {
  let html = html_format({ "lineanchors": "foo", "linenostart": "5" })
  assert_true(
    html.contains(
      "<pre><span></span><a id=\"foo-5\" name=\"foo-5\" href=\"#foo-5\">",
    ),
  )
}

///|
test "get_style_defs contains pre style" {
  let defs = @formatters.HtmlFormatter::new()
    .get_style_defs()
    .split("\n")
    .collect()
  inspect(defs[0], content="pre { line-height: 125%; }")
}

///|
test "get_style_defs contains default line numbers styles" {
  let defs = @formatters.HtmlFormatter::new()
    .get_style_defs()
    .split("\n")
    .collect()
  inspect(
    defs[1],
    content="td.linenos .normal { color: inherit; background-color: transparent; padding-left: 5px; padding-right: 5px; }",
  )
  inspect(
    defs[2],
    content="span.linenos { color: inherit; background-color: transparent; padding-left: 5px; padding-right: 5px; }",
  )
}

///|
test "get_style_defs contains style specific line numbers styles" {
  let style = @styles.Style::new(
    [],
    line_number_color="#ff0000",
    line_number_background_color="#0000ff",
    line_number_special_color="#00ff00",
    line_number_special_background_color="#ffffff",
  )
  let defs = @formatters.HtmlFormatter::new(style~)
    .get_style_defs()
    .split("\n")
    .collect()
  inspect(
    defs[1:5].map(s => s.to_owned()).join("\n"),
    content=(
      #|td.linenos .normal { color: #ff0000; background-color: #0000ff; padding-left: 5px; padding-right: 5px; }
      #|span.linenos { color: #ff0000; background-color: #0000ff; padding-left: 5px; padding-right: 5px; }
      #|td.linenos .special { color: #00ff00; background-color: #ffffff; padding-left: 5px; padding-right: 5px; }
      #|span.linenos.special { color: #00ff00; background-color: #ffffff; padding-left: 5px; padding-right: 5px; }
    ),
  )
}

///|
test "get_style_defs allows transparent color" {
  let style = @styles.Style::new([
    (@token.name, "transparent bg:transparent border:transparent"),
  ])
  let ndef = style.style_for_token(@token.name)
  assert_eq(ndef.color, Some("transparent"))
  assert_eq(ndef.bgcolor, Some("transparent"))
  assert_eq(ndef.border, Some("transparent"))
  assert_true(
    @formatters.HtmlFormatter::new(style~)
    .get_style_defs()
    .contains(
      ".n { color: transparent; background-color: transparent; border: 1px solid transparent } /* Name */",
    ),
  )
}

///|
test "get_token_style_defs uses css prefix" {
  let check = (lines : Array[String], starts : String, contains : Array[String]) => {
    assert_true(lines.length() > 0)
    for line in lines {
      assert_true(line.has_prefix(starts))
      for s in contains {
        assert_true(line.contains(s))
      }
    }
  }
  check(@formatters.HtmlFormatter::new().get_token_style_defs(), ".", [])
  let foo = @formatters.HtmlFormatter::new(options={ "cssclass": "foo" })
  check(foo.get_token_style_defs(), ".foo .", [])
  check(foo.get_token_style_defs(arg=".bar"), ".bar .", [])
  check(foo.get_token_style_defs_for([".bar", ".baz"]), ".ba", [
    ".bar .", ".baz .",
  ])
}

///|
test "get_background_style_defs uses multiple css prefixes" {
  let lines = @formatters.HtmlFormatter::new().get_background_style_defs_for([
    ".foo", ".bar",
  ])
  assert_true(lines[0].has_prefix(".foo .hll, .bar .hll {"))
  assert_true(lines[1].has_prefix(".foo , .bar {"))
}

///|
test "unicode options" {
  let f = @formatters.HtmlFormatter::new(options={
    "title": "Föö",
    "cssclass": "bär",
    "cssstyles": "div:before { content: 'bäz' }",
    "encoding": "utf-8",
    "full": "True",
  })
  let out = f.format(html_test_tokens())
  assert_true(out.contains("<title>Föö</title>"))
  assert_true(
    out.contains(
      "<div class=\"bär\" style=\"div:before { content: &#x27;bäz&#x27; }\">",
    ),
  )
}

///|
test "ctags is not supported" {
  let r = try
    @formatters.HtmlFormatter::new(options={ "tagsfile": "tests/support/tags" })
  catch {
    _ => true
  } noraise {
    _ => false
  }
  assert_true(r)
}

///|
test "filename" {
  let html = html_format({ "filename": "test.py" })
  assert_true(html.contains("<span class=\"filename\">test.py</span><pre>"))
  let html = html_format({})
  assert_true(!html.contains("<span class=\"filename\">"))
}

///|
test "debug token types" {
  let plain = html_format({ "debug_token_types": "False" })
  assert_true(
    !plain.contains("<span class=\"n\" title=\"Name\">TESTDIR</span>"),
  )
  let debug = html_format({ "debug_token_types": "True" })
  assert_true(debug.contains("<span class=\"n\" title=\"Name\">TESTDIR</span>"))
}

///|
test "html escape attributes" {
  let f = @formatters.HtmlFormatter::new(options={
    "cssclass": "bad<script>",
    "cssstyles": "color: \"&\"",
    "filename": "<file'>.py",
    "lineseparator": "<br>",
    "lineanchors": "anchor\"name",
    "linespans": "span&name",
  })
  inspect(f.cssclass, content="bad&lt;script&gt;")
  inspect(f.cssstyles, content="color: &quot;&amp;&quot;")
  inspect(f.filename, content="&lt;file&#x27;&gt;.py")
  inspect(f.lineseparator, content="&lt;br&gt;")
  inspect(f.lineanchors, content="anchor&quot;name")
  inspect(f.linespans, content="span&amp;name")
}
